{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Investafiction",
  "version": "1.0.0",
  "identifier": "test.investafiction.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "Investafiction", "width": 1440, "height": 900, "minWidth": 1024, "minHeight": 680 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Desktop investigation simulator",
    "longDescription": "Work fictional cases from first brief to final report. Offline only. Not official training.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
