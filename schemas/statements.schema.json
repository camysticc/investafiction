{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investafiction.test/schemas/statements.schema.json",
  "title": "Witness statements split into claims",
  "description": "Optional. Each statement is also an evidence document. The expected conflicts and checks live in solution.json, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["statements"],
  "properties": {
    "statements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "evidence", "witness", "role", "date", "claims"],
        "properties": {
          "id": { "type": "string", "pattern": "^ST-[0-9]+$" },
          "evidence": { "type": "string", "description": "The evidence document that holds the full statement." },
          "witness": { "type": "string" },
          "role": { "type": "string" },
          "date": { "type": "string" },
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text"],
              "properties": {
                "id": { "type": "string", "pattern": "^ST-[0-9]+\\.[0-9]+$" },
                "text": { "type": "string" },
                "time": { "type": "string", "format": "date-time" },
                "place": { "type": "string", "description": "A map location id." },
                "entities": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
