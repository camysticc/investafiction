{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investafiction.test/schemas/solution.schema.json",
  "title": "Case solution and marking rubric",
  "description": "Read only by the core. Released to the interface only after the report is submitted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "links", "timeline", "herrings", "grades", "objective_checks", "stage_unlocks", "hints", "noise", "gaps", "next_steps"],
  "$defs": {
    "keywords": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
    },
    "condition": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["start", "all", "any", "received", "examined", "hashed", "finding", "findings_count", "request_granted", "authority", "timeline_count", "timeline_event", "link", "links_count", "captured", "graded", "objectives", "legality_done", "scope_acknowledged", "hash_mismatch_reported"] },
        "of": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "ids": { "type": "array", "items": { "type": "string" } },
        "all_released": { "type": "boolean" },
        "min": { "type": "integer" },
        "key": { "type": "string" },
        "request": { "type": "string" },
        "id": { "type": "string" },
        "a": { "type": "string" },
        "b": { "type": "string" },
        "pages": { "type": "array", "items": { "type": "string" } },
        "stage": { "type": "string" }
      }
    }
  },
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "statement", "type", "evidence_any", "min_sources", "keywords", "explain"],
        "properties": {
          "id": { "type": "string", "pattern": "^KF-[0-9]+$" },
          "required": { "type": "boolean" },
          "stage": { "type": "string" },
          "statement": { "type": "string" },
          "type": { "enum": ["fact", "inference", "assumption"] },
          "evidence_any": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "min_sources": { "type": "integer", "minimum": 1 },
          "keywords": { "$ref": "#/$defs/keywords" },
          "explain": { "type": "string" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["a", "b", "evidence_any", "note"],
        "properties": {
          "a": { "type": "string" },
          "b": { "type": "string" },
          "evidence_any": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" }
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "time", "label", "evidence_any", "tolerance_minutes"],
        "properties": {
          "id": { "type": "string", "pattern": "^TL-[0-9]+$" },
          "time": { "type": "string", "format": "date-time" },
          "label": { "type": "string" },
          "evidence_any": { "type": "array", "items": { "type": "string" } },
          "tolerance_minutes": { "type": "integer" },
          "key": { "type": "boolean" }
        }
      }
    },
    "herrings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "evidence", "keywords", "explain"],
        "properties": {
          "id": { "type": "string", "pattern": "^RH-[0-9]+$" },
          "label": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "keywords": { "$ref": "#/$defs/keywords" },
          "explain": { "type": "string" }
        }
      }
    },
    "grades": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "info"],
        "properties": {
          "source": { "enum": ["A", "B", "C", "D", "E"] },
          "info": { "enum": ["1", "2", "3", "4", "5"] }
        }
      }
    },
    "objective_checks": { "type": "object", "additionalProperties": { "$ref": "#/$defs/condition" } },
    "stage_unlocks": { "type": "object", "additionalProperties": { "$ref": "#/$defs/condition" } },
    "hints": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3 }
    },
    "noise": { "type": "array", "items": { "type": "string" } },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "keywords"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "keywords": { "$ref": "#/$defs/keywords" }
        }
      }
    },
    "next_steps": { "type": "string" },
    "story": { "type": "string" }
  }
}
